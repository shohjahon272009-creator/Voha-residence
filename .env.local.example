# ============================================================
# Voha Residence — muhit o'zgaruvchilari namunasi
# Bu faylni `.env.local` deb nusxalab, qiymatlarni to'ldiring.
# HAQIQIY kalitlarni bu faylga YOZMANG — u git'da saqlanadi.
# ============================================================

# Admin sessiya cookie'sini imzolaydigan maxfiy kalit (MAJBURIY).
# Yaratish:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Turso bulutli baza (Vercel/serverless uchun) ---
# Bular O'RNATILMASA, lokal `qurilish.db` fayli ishlatiladi (ishlab chiqish).
# Vercel'da ishlashi va admin o'zgarishlari saqlanishi uchun IKKALASI ham shart.
# DIQQAT: token TO'LIQ (read-write) bo'lsin — `--read-only` EMAS.
# Olish:  DEPLOY.md -> "Vercel + Turso" bo'limi.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
